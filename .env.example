# NVIDIA API key from NVIDIA API Catalog / build.nvidia.com
NVIDIA_API_KEY=your_key_here

# Hosted Nemotron model and OpenAI-compatible NVIDIA NIM endpoint.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional local SQLite path. Leave unset to use data/careerpilot.db.
CAREERPILOT_DB_PATH=data/careerpilot.db

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-career-coach-agent
